{
  "name": "shortener-url",
  "version": "1.0.0",
  "description": "API de acortador de URLs con autenticación por código de verificación",
  "type": "module",
  "main": "dist/src/run.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "nodemon src/run.ts",
    "build": "tsc && npm run copy:assets",
    "copy:assets": "node -e \"require('fs').cpSync('src/Database/schema.sql','dist/src/Database/schema.sql',{recursive:true})\"",
    "start": "node dist/src/run.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" jest",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" jest --coverage",
    "stress": "STRESS_TEST=true tsx ./test/stress/stress-tester.ts",
    "stress:full": "NODE_ENV=production STRESS_TEST=true tsx ./test/stress/stress-tester.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.3",
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@libsql/client": "^0.17.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "nanoid": "^5.1.9",
    "nodemailer": "^10.3.1",
    "winston": "^3.19.0"
  },
  "overrides": {
    "brace-expansion@^1.1.7": "^1.1.21",
    "brace-expansion@^2.0.0": "^2.1.7",
    "brace-expansion@^5.0.0": "^5.0.12",
    "js-yaml@^3.13.1": "^3.15.2",
    "uuid@^8.3.2": "^11.1.1"
  }
}
