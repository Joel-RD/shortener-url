# Puerto del servidor (por defecto 3000)
PORT=

# Entorno: "production" activa los límites estrictos y exige JWT_SECRET
NODE_ENV=

# Base de datos remota (Turso). Solo se usa cuando NODE_ENV=production
DB_TURSO_URL=
DB_TURSO_AUTH_TOKEN=

# Base de datos local (desarrollo). Opcional; por defecto src/Database/databases.db
DB_FILE=

# Origen del frontend para CORS (por defecto http://localhost:3000)
FRONTEND_ORIGIN=

# Alias de compatibilidad con FRONTEND_ORIGIN
DOMAIN_FOR_FRONTEND=

# Lista separada por comas si hay varios orígenes permitidos
CORS_ORIGINS=

# Base con la que se construyen las URLs cortas (por defecto FRONTEND_ORIGIN)
SHORT_URL_BASE=

# Número de proxies de confianza para obtener la IP real del cliente
# Ejemplos: 1 (un proxy), true, "loopback"
TRUST_PROXY=

# JsonWebTokens (obligatorio en producción)
JWT_SECRET=

# Configuración de cookies
HTTP_ONLY=true
SECURE=false
SAME_SITE=lax
MAX_AGE=604800000
COOKIE_PATH=/

# Configuración SMTP
# Email host (ej: smtp.gmail.com)
EMAIL_HOST=
# Puerto SMTP
EMAIL_PORT=587
# TLS implícito (true para puerto 465)
EMAIL_SECURE=false
# Email corporativo
EMAIL_USER=
# Contraseña del email
EMAIL_PASS=

# Desarrollo: silencia morgan
SKIP_LOGS=
